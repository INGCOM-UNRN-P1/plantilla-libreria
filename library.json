{
  "name": "matematica",
  "version": "1.0.0",
  "repository": "https://github.com/usuario/matematica-libreria.git",
  "build": {
    "command": "make",
    "clean_command": "make clean"
  },
  "exports": {
    "headers": [
      {
        "source": "include/matematica.h",
        "destination": "include/matematica.h"
      }
    ],
    "binaries": [
      {
        "source": "build/libmatematica.a",
        "destination": "lib/libmatematica.a"
      }
    ]
  }
}
